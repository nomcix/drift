      "parameters": {
        "amount": 2
      }
    },
    {
      "moduleId": "hazard-shield",
      "label": "Hazard Shield",
      "description": "The assigned unit ignores the first radiation damage event.",
      "effectType": "prevent-hazard-damage",
      "parameters": {
        "uses": 1
      }
    },
    {
      "moduleId": "cargo-clamp",
      "label": "Cargo Clamp",
      "description": "The assigned carrier ignores the first forced mission-item drop.",
      "effectType": "prevent-cargo-drop",
      "parameters": {
        "uses": 1
      }
    },
    {
      "moduleId": "memory-buffer",
